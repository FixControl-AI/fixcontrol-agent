# fc-agent-config — DEFAULTS.
#
# This file is the base layer of the `fc-agent-config` ConfigMap. install.sh
# renders the ConfigMap from this file FIRST and the customer's values SECOND,
# so every key here is overridable and none of them has to be repeated in
# values.env. Keys are read as literal strings; `#` starts a comment line.
#
# The defaults are chosen so that an install that overrides nothing is the
# highest-security profile that can still work, per invariant 5 of the plan.

# ── Identity of this agent as it reports itself ─────────────────────────────
AGENT_NAME=fc-agent

# ── Capabilities this agent CLAIMS ──────────────────────────────────────────
# Claiming a capability is a decision, so the default is the smallest useful
# set. `test.run` / `test.cancel` belong to fc-test-runner's separate identity
# and must NEVER appear here. Add `ci.approve_deployment,ci.reject_deployment`
# together with a CI_CONFIG — a claimed CI capability with no CI_CONFIG entry
# refuses every operation `not_allowlisted`, which is safe but reads as a
# misconfiguration.
AGENT_CAPABILITIES=rollout.promote,rollout.status

# ── Check 6: the customer-owned allowlists ──────────────────────────────────
# FixControl never sends these. A FixControl-side bug or compromise that emits
# "promote everything in kube-system" is refused right here.
# Empty allowlists NOTHING — there is deliberately no spelling for "all
# namespaces". install.sh refuses an install that leaves ALLOWED_NAMESPACES
# empty, because an agent that can never act is a silent failure.
ALLOWED_NAMESPACES=
# "ns/name" items, or "*" for every Rollout inside the namespaces above.
ALLOWED_ROLLOUTS=*

# ── Signing-key pin (check 3) — see Step 16 of the README ───────────────────
# PUBLIC material, hence a ConfigMap: these keys verify, they cannot sign.
# Empty = the legacy shared-secret mode, which is a migration step and not a
# posture. install.sh WARNS loudly when it is empty and refuses when
# FC_REQUIRE_SIGNING_PIN=1 (the recommended production setting).
FIXCONTROL_SIGNING_PUBLIC_KEYS=

# ── Timing ──────────────────────────────────────────────────────────────────
POLL_SECONDS=10
CLOCK_SKEW_SECONDS=300

# ── Promotion profile ───────────────────────────────────────────────────────
# Profile (a) — GitOps marker commit. Invariant 5: the highest-security profile
# is the DEFAULT, not an option. Switch to "receiver" only when the customer
# already runs fc-receiver.
PROMOTE_MODE=git
GIT_PROMOTE_REPO=
GIT_PROMOTE_BRANCH=main
# Profile (c) — in-cluster receiver over ClusterIP, no Ingress needed.
# RECEIVER_SECRET lives in the Secret, not here.
RECEIVER_URL=
# Profile (b) — live Argo API. OFF by default; turning it on is an explicit
# per-cluster action that ALSO widens RBAC (see base/rollout-rbac).
ARGO_LOCAL_API=0

# ── Events (cluster → FixControl, same outbound channel) ────────────────────
EVENTS_ENABLED=1

# ── Metrics / health ────────────────────────────────────────────────────────
# Loopback only — the agent ships no Service, so nothing in the cluster should
# be able to reach its metrics. The liveness probe is an exec probe for exactly
# this reason.
METRICS_HOST=127.0.0.1
METRICS_PORT=8080

AGENT_WORK_DIR=/tmp/fc-agent

# ── Phase 3: private CI hosts ───────────────────────────────────────────────
# CI_CONFIG is NOT set here: it is nested JSON and lives in its own file, so a
# customer edits real JSON with real editor support. install.sh mounts
# FC_CI_CONFIG_FILE (default: base/agent/ci-config-empty.json, which allowlists
# nothing) into this ConfigMap under the key CI_CONFIG.
#
# Per CI-host call, bounded. The agent makes at most three calls per operation
# (pre-check, write, best-effort state re-read).
CI_TIMEOUT_SECONDS=10
