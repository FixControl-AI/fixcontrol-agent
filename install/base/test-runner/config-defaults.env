# fc-test-runner-config — DEFAULTS.
#
# Base layer of the `fc-test-runner-config` ConfigMap; install.sh renders this
# file first and the customer's values second. `#` starts a comment line.

AGENT_NAME=fc-test-runner

# This runner serves the test capabilities and NOTHING else. Rollout
# capabilities belong to fc-rollout-controller, whose credentials this pod does
# not hold (plan invariant 4 — separated by blast radius).
AGENT_CAPABILITIES=test.run,test.cancel

# The FixControl signing keys this cluster trusts — check 3, and the same value
# the fc-agent ConfigMap carries.
#
# PIN BOTH COMPONENTS OR NEITHER. fc-agent and fc-test-runner redeem the same
# envelopes from the same FixControl; a fleet that pins one and not the other
# still has a process trusting the old authority, which is the whole thing
# being removed. install.sh writes the SAME value into both and has no spelling
# for pinning one.
FIXCONTROL_SIGNING_PUBLIC_KEYS=

POLL_SECONDS=5
MAX_SKEW_SECONDS=300
MAX_CONCURRENT_RUNS=1

# Ephemeral-namespace TTL. The sweeper reclaims any fc-test-* namespace whose
# `fixcontrol.expires` label is in the past, every poll cycle, regardless of
# which process created it — so a SIGKILL + restart still reclaims
# (invariant 8 / acceptance criterion 9).
NAMESPACE_TTL_SECONDS=3600

# Customer-owned image allowlist, applied to the toolchain image AND to every
# service image in the environment spec. Set e.g.
# "registry.internal/,docker.io/library/node" to close the door on your own
# terms — this knob is yours, not FixControl's.
#
# EMPTY = ANY IMAGE. That is the shipped default for backward compatibility
# (an install that never set it keeps working), and it is the one allowlist in
# this package that is permissive when empty — ALLOWED_NAMESPACES allowlists
# NOTHING when empty. The runner says so out loud once per process
# (`event: config.image_allowlist_open`, level warn); if that line is in your
# logs and you meant to close the door, this is the setting.
#
# The prefix match is boundary-aware: "ghcr.io/acme" admits ghcr.io/acme,
# ghcr.io/acme/x and ghcr.io/acme:1, and does NOT admit ghcr.io/acmeattacker/x.
ALLOWED_TOOLCHAIN_IMAGE_PREFIXES=

# Customer-owned COMMAND allowlist: the bare binary names a plan step may
# invoke, csv. A step whose argv[0] basename is not listed refuses the whole
# operation (`not_allowlisted`) before the run namespace is created — the plan
# is never edited to fit.
#
# EMPTY = the runner's built-in default, which reproduces FixControl's own
# closed command set (node/npm/pnpm/yarn/bun/npx, python/python3/pip/pip3/
# pipenv/poetry/pytest/mypy/alembic, composer/php, go/cargo, mvn/gradle/dotnet,
# bundle/ruby/rake, cmake/ctest/meson/ninja/make, wdcli) plus sh and bash.
# `sh`/`bash` are admitted ONLY as "sh <workspace-script>.sh" — `-c` is refused.
#
# `git` is NOT in the default, even though the checkout lane runs it: that lane
# runs git inside the runner's own image, never as a plan step, and no plan
# FixControl sends asks for it. If your repository's toolchain genuinely needs
# git as a plan step, add it deliberately (ALLOWED_COMMANDS=npm,npx,node,git) —
# it is the widest verb this list can hold, since `git -c alias.…` runs
# arbitrary programs.
#
# A value REPLACES the default; that is how you spell "this cluster runs
# exactly these verbs" (e.g. ALLOWED_COMMANDS=npm,npx,node for a Node-only
# estate). FixControl can narrow this list per operation and has no spelling
# for widening it: an operation-supplied grant is intersected with it.
ALLOWED_COMMANDS=

SERVICE_START_BUDGET_MS=120000

# ── The runner-side checkout lane (workspaceRef.kind: "git-remote") ────────
# Where the runner looks for the two CUSTOMER-OWNED objects that make the lane
# possible. Both are mounted `optional: true` by the Deployment, so leaving
# them uncreated is a complete and supported configuration: the runner then
# advertises only `channel-tar` on every poll and refuses any git-remote
# operation locally. See install/base/test-runner/customer-git.example.yaml.
#
# These match the image's own defaults and are spelled out here so the paths
# are visible in the render rather than only in the Dockerfile.
REPO_KEYS_FILE=/etc/fc-test-runner/repos/repos.json
GIT_CREDENTIALS_DIR=/etc/fc-test-runner/git

# The persisted single-use nonce ledger. Its name is pinned by `resourceNames`
# in the runner's Role — changing it here without changing the Role there
# silently degrades the store to in-memory.
NONCE_CONFIGMAP=fc-test-runner-nonces

# RUNNER_IMAGE is NOT set here. install.sh writes it from the same values.env
# key that pins the container image, because the two must be byte-identical and
# a default would let them drift.

# ALLOW_INSECURE_FIXCONTROL_URL is NOT set here, and must never be set in a
# customer install. It exists so a development rig can reach a plaintext dev
# server, and it is set only in such a rig's own overlay. Without it a plaintext
# FixControl URL fails the pod at boot, which is the behaviour a production
# install wants.
